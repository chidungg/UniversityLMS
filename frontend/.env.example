# ==============================================================
# University LMS - Frontend Environment Configuration Template
# ==============================================================
# Copy this file to .env and adjust variables for your local setup.

# Vite Development Server Port (default: 5173)
VITE_PORT=5173

# Optional: Direct Backend API URL if bypassing Vite proxy
# By default, vite.config.js proxies /api, /demo-assets, /uploads to http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api
