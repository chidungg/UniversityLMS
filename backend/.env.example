# ==============================================================
# University LMS - Backend Environment Configuration Template
# ==============================================================
# Copy this file to .env and adjust variables for your local setup.
# IMPORTANT: Never commit actual credentials or secrets to git.

# Server HTTP Port (default: 5000)
PORT=5000

# MongoDB Connection String (e.g. local instance or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/UniversityLMS

# MongoDB Database Name
MONGO_DB_NAME=UniversityLMS

# JSON Web Token (JWT) Secret Key for Authentication
JWT_SECRET=your_secure_jwt_secret_token_here_minimum_32_characters

# Allowed Frontend Client Origin for CORS headers (Vite dev server default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
