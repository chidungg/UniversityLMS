# ==============================================================
# University LMS - Root Workspace Environment Template
# ==============================================================
# This monorepo includes both Backend (Express + MongoDB) and Frontend (React + Vite).
# Please refer to specific configuration files:
#   - Backend: backend/.env.example -> backend/.env
#   - Frontend: frontend/.env.example -> frontend/.env

# Quick Reference - Backend Configuration
BACKEND_PORT=5000
BACKEND_MONGO_URI=mongodb://localhost:27017/UniversityLMS
BACKEND_JWT_SECRET=your_secure_jwt_secret_token_here_minimum_32_characters

# Quick Reference - Frontend Configuration
FRONTEND_PORT=5173
